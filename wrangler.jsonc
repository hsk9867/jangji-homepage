{
  // 배웅 홈페이지 — Cloudflare Workers (정적 파일 + 관리자 API + D1 + R2)
  // 처음 한 번:  npx wrangler login
  //             npx wrangler d1 create baewoong-db        → 나온 database_id 를 아래에 적기
  //             npx wrangler r2 bucket create baewoong-uploads
  //             npx wrangler d1 migrations apply baewoong-db --remote
  // 배포:        npx wrangler deploy
  // 시크릿(별도 터미널 창에서):  npx wrangler secret put SESSION_SECRET   (아무 긴 무작위 문자열)
  //                              npx wrangler secret put RESEND_API_KEY   (문의 알림 메일을 쓸 때만)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baewoong",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "baewoong-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "baewoong-uploads" }
  ],
  "vars": {
    // 문의 알림 메일 보내는 주소. Resend 에서 도메인 인증 후 예: "no-reply@배웅도메인"
    "MAIL_FROM": ""
  },
  "observability": { "enabled": true }
}
